{
  "name": "wpp-ui",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "prefix": "wpp",
  "sourceRoot": "./src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "options": {
        "baseHref": "/",
        "externalDependencies": ["marked-katex-extension"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ]
        },
        "preview": {
          "baseHref": "/apps/wpp-ui/",
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        }
      }
    },
    "serve": {},
    "serve-static": {},
    "test": {
      "options": {
        "coverageThresholds": {
          "branches": 10,
          "functions": 10,
          "lines": 10,
          "statements": 10
        }
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx format:write"
      }
    }
  }
}
